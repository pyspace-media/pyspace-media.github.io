# Copy this file to .env and fill in real values for your environment.
# Never commit your actual .env file.

# Django's cryptographic signing key. Generate a real one for anything
# beyond local development, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=dev-secret-key-not-for-production-change-me

# Set to False in production.
DEBUG=True

# Comma-separated list of hosts/domains this site is allowed to serve.
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of trusted origins for CSRF (needed behind HTTPS
# reverse proxies / when your domain differs from ALLOWED_HOSTS), e.g.:
# CSRF_TRUSTED_ORIGINS=https://pyspace.example.com
CSRF_TRUSTED_ORIGINS=

# If set, overrides the default SQLite database with a full connection
# string, e.g. postgres://user:password@host:5432/dbname
DATABASE_URL=

TIME_ZONE=UTC

# Redirect all traffic to HTTPS in production (ignored when DEBUG=True).
SECURE_SSL_REDIRECT=True

# --- Email (used for password reset) ---
# Defaults to printing emails to the console, which is fine for local dev.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@pyspace.local

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=8

# --- Rate limiting ---
RATE_LIMIT_POSTS_PER_MINUTE=10
RATE_LIMIT_COMMENTS_PER_MINUTE=20
